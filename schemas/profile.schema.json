{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wimi321/mac-to-windows-testing-skill/schemas/profile.schema.json",
  "title": "Mac-to-Windows project profile",
  "type": "object",
  "required": ["version", "project", "commands", "automation", "scenarios"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "repository", "windowsWorkspace", "artifact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "windowsWorkspace": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": ["build", "test", "launch"],
      "properties": {
        "build": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "launch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": ["transport", "repairLimit", "visualConfidenceThreshold", "allowDestructiveActions"],
      "properties": {
        "transport": { "enum": ["ssh", "winrm", "uu-computer-use", "windows-agent"] },
        "repairLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "visualConfidenceThreshold": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "allowDestructiveActions": { "type": "boolean" },
        "keepApplicationRunning": { "type": "boolean", "default": false },
        "destructiveFixture": {
          "type": "object",
          "required": ["isolated", "label"],
          "properties": {
            "isolated": { "const": true },
            "label": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "name": { "type": "string" },
        "nameContains": { "type": "string", "minLength": 1 },
        "nameRegex": { "type": "string", "minLength": 1 },
        "automationId": { "type": "string" },
        "controlType": { "type": "string" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["wait", "discover", "screenshot", "assert", "click", "type", "shortcut", "close"] },
        "checkpoint": { "type": "string" },
        "seconds": { "type": "number", "minimum": 0, "maximum": 300 },
        "target": { "$ref": "#/$defs/target" },
        "otherTarget": { "$ref": "#/$defs/target" },
        "condition": { "enum": ["exists", "notExists", "enabled", "focusable", "focused", "visible", "textEquals", "withinWindow", "noOverlap"] },
        "value": { "type": "string" },
        "text": { "type": "string" },
        "keys": { "type": "string" },
        "tolerancePixels": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "window", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "window": { "$ref": "#/$defs/target" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
